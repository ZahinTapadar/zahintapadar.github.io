rules_version = '2';

// Blog data: one document per post at posts/{slug} with `views` and `likes`,
// and anonymous comments under posts/{slug}/comments. Anyone can read. A
// counter write may only add one view, or add/remove one like.
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{slug} {
      allow read: if true;

      allow create: if slug.matches('^[a-z0-9-]{1,100}$')
        && request.resource.data.keys().hasOnly(['views', 'likes'])
        && request.resource.data.get('views', 0) in [0, 1]
        && request.resource.data.get('likes', 0) in [0, 1];

      allow update: if request.resource.data.keys().hasOnly(['views', 'likes'])
        && (
          (request.resource.data.get('views', 0) == resource.data.get('views', 0) + 1
            && request.resource.data.get('likes', 0) == resource.data.get('likes', 0))
          ||
          (request.resource.data.get('views', 0) == resource.data.get('views', 0)
            && (request.resource.data.get('likes', 0) - resource.data.get('likes', 0)) in [1, -1]
            && request.resource.data.get('likes', 0) >= 0)
        );

      // Anonymous comments: plain text, a short optional name, server time.
      // Nobody can edit or delete from the site; moderate in the console.
      match /comments/{commentId} {
        allow read: if true;

        allow create: if slug.matches('^[a-z0-9-]{1,100}$')
          && request.resource.data.keys().hasOnly(['name', 'body', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
